<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK: типов ASP.NET (IServiceCollection, IConfiguration,
         ILogger, IHostedService) много, и без Web SDK FrameworkReference
         Microsoft.AspNetCore.App их не подтягивает. OutputType=Library и без
         Program.cs — обычный режим библиотеки, Main не требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ДВЕ сборки: ClaudeHomeServer.Tests (нужен существующим
         тестам в Main, которые остаются — FileServiceGitStatusTests использует GitService)
         и ClaudeHomeServer.Git.Tests (будущая тестовая сборка вертикали, зовёт
         internal RunAsync/RunOkAsync). Без обоих атрибутов тестовые сборки не
         скомпилируются (GitService.RunAsync/RunOkAsync остались internal после волны 3
         линии Dossiers↔Git). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Git.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

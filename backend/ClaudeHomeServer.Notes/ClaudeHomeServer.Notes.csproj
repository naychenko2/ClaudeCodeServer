<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK: типов ASP.NET (IServiceCollection, IConfiguration,
         ILogger, IHostedService) много, и без Web SDK FrameworkReference
         Microsoft.AspNetCore.App их не подтягивает. OutputType=Library и без
         Program.cs — обычный режим библиотеки, Main не требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo только ТЕСТОВЫМ сборкам — как у Git/Skills/CodeGraph.
         Атрибута на сам ClaudeHomeServer (Main) здесь СОЗНАТЕЛЬНО нет: спине нужен
         ровно один член вертикали — NotesKnowledgeService.BuildRecallBlock, и он
         сделан public. Держать его internal значило бы прятать часть публичного
         контракта вертикали и раздавать Main доступ ко ВСЕМ её internals ради
         одного форматтера (находка ревью 2026-09-08).
         - ClaudeHomeServer.Tests: NotesTaskSyncIntegrationTests дергает
           NoteTaskSyncService через DI-контейнер, нужны внутренние поля.
         - ClaudeHomeServer.Notes.Tests: юниты самой вертикали. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Notes.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

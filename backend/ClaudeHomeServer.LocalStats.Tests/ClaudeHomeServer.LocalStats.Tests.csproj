<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали LocalStats (шаг 3.10, пачка F). По образцу Llm.Tests (3.1)
         и TestRuns.Tests (3.7): SDK=Web ради FrameworkReference Microsoft.AspNetCore.App
         (ILogger/IServiceCollection/SignalR и пр. ASP.NET-типы, на которые опираются
         LocalStats-тесты), OutputType=Library ради отсутствия Main.
         Продуктовый код LocalStats живёт внутри сборки ClaudeHomeServer.Llm
         (ClaudeHomeServer.Llm/LocalStats/**), отдельного проекта нет — ссылка на Llm. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Монолит (ClaudeHomeServer.Tests) в переходный период (до финальной чистки)
         держит временную ссылку на эту сборку (ClaudeHomeServer.Tests.csproj):
         допуск internals LocalStats.Tests монолиту, как у TestRuns.Tests/Mcp.Tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Llm — продуктовая сборка, внутри которой живёт код LocalStats
         (PrometheusTextParser/VllmMetricsSource/GpuSampler/LocalModelStatsPoller/
         SseUsageObserver/LocalModelTurnMeter/LocalModelLiveSink). Отдельного проекта
         ClaudeHomeServer.LocalStats нет, поэтому ссылка прямая, как в монолите. -->
    <ProjectReference Include="..\ClaudeHomeServer.Llm\ClaudeHomeServer.Llm.csproj" />
    <!-- Core — спинка: Models/Protocol/Services.*, на которые ссылаются using'ы
         перенесённых тестов. -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- TestKit — Core-only хелперы (FakeHostEnvironment/TestLauncherFactory/TestConfig),
         используемые LocalStats-тестами (напр. LocalModelLiveSinkTests). -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit\ClaudeHomeServer.TestKit.csproj" />
    <!-- TestKit.Host — Main-зависимые хелперы (TestWebApplicationFactory/GatewayTestKit);
         namespace ClaudeHomeServer.Tests.Services.Gateway, на который ссылается
         LocalModelTurnMeterTests, объявлен здесь. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit.Host\ClaudeHomeServer.TestKit.Host.csproj" />
    <!-- Main: LocalStats-тесты конструируют UserStore/Hubs/Services.* и опираются на
         Services.Llm/Services.Composition/Services.Notes/Services.Skills/Services.Turn,
         на которые ссылаются все перенесённые тесты. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- Moq: LocalModelLiveSinkTests мокет ILocalModelLiveSink-зависимости. -->
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <!-- LocalStats-фикстуры: тесты резолвят AppContext.BaseDirectory + "Fixtures"/"LocalStats"/<name>
         (PrometheusTextParserTests/VllmMetricsSourceTests/SseUsageObserverTests). Файлы не дублируем:
         относительная ссылка на источник в монолите (ClaudeHomeServer.Tests/Fixtures/LocalStats) + Link,
         чтобы они легли в output LocalStats.Tests по пути Fixtures/LocalStats/…. -->
    <None Include="..\ClaudeHomeServer.Tests\Fixtures\LocalStats\**"
          CopyToOutputDirectory="PreserveNewest"
          Link="Fixtures/LocalStats/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

<Project TreatAsLocalProperty="TargetFramework">

  <!--
    TreatAsLocalProperty="TargetFramework" — защита от языкового сервера: csharp-ls
    грузит solution с одним общим набором MSBuild-свойств и навязывает всем проектам
    TFM самого «широкого» из них (net10.0-windows от ClaudeHomeServer.Tray). Из-за этого
    проекты с чистым net10.0 теряли ссылки, и в тестах сыпался CS0246 на
    Xunit/FluentAssertions. Атрибут делает TargetFramework локальным — проект
    использует свой собственный. На сборку не влияет.

    Осторожно: с этим атрибутом внешний -f / /p:TargetFramework по проектам backend
    больше НЕ переопределяет TFM. Все проекты однотаргетные, -f в скриптах не
    используется. Если появится мультитаргетный проект — атрибут ему помешает,
    тогда переносить его точечно в нужные .csproj.
  -->

  <!--
    Общие настройки MSBuild для всех проектов backend.
    Применяется автоматически ко всем .csproj ниже по дереву.
  -->

  <PropertyGroup>
    <!--
      «Предупреждение = ошибка» точечно, без TreatWarningsAsErrors: в ошибку
      превращаются только nullable-предупреждения компилятора и xUnit1031
      (анализатор xUnit). Остальные предупреждения остаются предупреждениями.

      Решение от 25.10.2026 (Андрей), осознанно меняет прежнее: гейт
      «-warnaserror только в CI, локально предупреждения не мешают отладке».
      Теперь nullable-предупреждение роняет сборку и локально — предупреждение
      о неинициализированном значении должно быть видно сразу, а не на CI.
      Жёсткий полный гейт остаётся в CI (.github/workflows/ci.yml:54) — там
      -warnaserror по-прежнему включает ВСЕ предупреждения.

      Ветки позади master на новой базе начнут падать на унаследованных
      nullable-предупреждениях: лечится вливанием master, а не правкой props.
    -->
    <WarningsAsErrors>nullable;xUnit1031</WarningsAsErrors>

    <!--
      Исключения из «предупреждение = ошибка». Список кодов, которые гейт НЕ
      ловит, — командной строкой его не передать, точка с запятой там
      разделяет свойства.

      NU1900 — не удалось опросить фид (сеть и доступность зеркала, а не код).
      NU1901-NU1904 — аудит зависимостей: краснеет от публикации нового advisory
      в мире, без единого коммита в репозитории. Уязвимости при этом продолжают
      светиться в выводе сборки — глушится только превращение их в ошибку.
    -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Точечное подавление NuGet-audit по конкретному advisory (не глушим весь NU1903,
      чтобы новые уязвимости продолжали светиться в сборке).

      GHSA-2m69-gcr7-jv3q — memory corruption в движке SQLite < 3.50.2, приходит
      транзитивно как SQLitePCLRaw.lib.e_sqlite3 2.1.11 через Microsoft.Data.Sqlite.
      Ветка 2.1.x официально НЕ патчится ("Patched: None"); фикс только через major-bump
      на SQLitePCLRaw 3.0.x (новый поставщик нативки), с которым Microsoft.Data.Sqlite 10.0.x
      официально не завязан (просит core 2.1.11) — риск несовместимости.

      Обоснование подавления: sqlite в проекте — это ЛОКАЛЬНЫЙ append-only лог событий
      (ProjectEventLogService, project-events.db). Весь SQL свой и параметризованный,
      произвольный SQL извне не исполняется — вектор эксплуатации этой уязвимости
      (aggregate terms > columns в подконтрольном атакующему запросе) отсутствует.
      Снять подавление, когда Microsoft.Data.Sqlite подтянет SQLitePCLRaw 3.x с SQLite >= 3.50.2.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ядро клиента: протокол канала, сам канал, локальный журнал вызовов и политики.
    TFM — чистый net10.0 БЕЗ -windows: всё, что зовёт WinAPI (кадр, ввод, DPAPI, трей),
    живёт в AiHomeDesktop.Windows, а ядро остаётся под платформонезависимыми тестами.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>

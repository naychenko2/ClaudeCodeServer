<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK (по образцу Turn/Tasks/Spend/Notes/Knowledge): типов ASP.NET
         (IServiceCollection, IConfiguration, ILogger, IHostedService) много, и без
         Web SDK FrameworkReference Microsoft.AspNetCore.App их не подтягивает.
         OutputType=Library и без Program.cs — обычный режим библиотеки, Main не
         требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ClaudeHomeServer.Tests: остаток тестов вертикали (вторая
         половина ClaudeSession*Tests и Provider/Fallback/Subscription/Transcript) ещё живёт
         в монолите и опирается на internal-члены `ClaudeSession`/`CheapTextRunner` и пр. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- InternalsVisibleTo на ClaudeHomeServer.Llm.Tests (шаг 3.1): первая половина
         ClaudeSession*Tests переехала в отдельную тестовую сборку вертикали и тоже
         опирается на те же internal-члены `ClaudeSession`/`CheapTextRunner` и пр. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Llm.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Personas.Tests (шаг 3.4): PersonaLightContextTests/ProjectSessionPersonaLayerGuardTests
         читают internal ClaudeSession.BuildBareModeArgs. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Personas.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Mcp.Tests (шаг 3.6): TurnTokenAdapterBranchesTests читает internal
         FallbackLlmSessionAdapter.HandleMessageAsync — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Mcp.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- LocalStats.Tests (шаг 3.10): перенесённые LocalStats-тесты (PrometheusTextParser/
         VllmMetricsSource/GpuSampler/LocalModelStatsPoller/SseUsageObserver/LocalModelTurnMeter/
         LocalModelLiveSink/CoreContracts) читают internal-члены ClaudeHomeServer.Llm/LocalStats —
         тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.LocalStats.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

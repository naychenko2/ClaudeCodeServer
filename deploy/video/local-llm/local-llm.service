[Unit]
Description=Gemma 4 26B-A4B (llama-server, PrismML fork) — дежурная модель одношаговых мест и локальный провайдер чатов CCS
After=network-online.target
# Арбитр gpu-arbiter.service останавливает и запускает этот юнит; руками — только для отладки.
# Модель выбрана A/B 31.10.2026 (17 мест CCS: 337/340 валидных; см. README).

[Service]
User=an
WorkingDirectory=/home/an/local-llm
# Сборка cuda-13.3 форка + cudart/cublas 13 (копия из venv ComfyUI в cudalibs/cu13). Сборка
# cuda-12.8 лежит в bin/cuda128 запасной: ей нужны cudart/cublas 12 (колёса в cudalibs/*.whl).
Environment=LD_LIBRARY_PATH=/home/an/local-llm/cudalibs/cu13:/usr/lib/wsl/lib:/home/an/local-llm/bin/cuda133
Environment=CUDA_VISIBLE_DEVICES=0
# Размышления выключены по умолчанию: Anthropic API (чаты провайдера через Claude CLI) не шлёт
# enable_thinking, а Gemma без него думает на каждый вопрос. Места CCS шлют то же значение сами.
Environment='LLAMA_ARG_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}'
# Сэмплинг — дефолты сервера; CCS шлёт temperature 0 в каждом запросе места.
# Gemma 4 26B-A4B UD-IQ4_XS (unsloth): 13,6 ГБ весов. -c 262144 -np 4 -kvu: общий пул KV на всё
# окно модели, 4 слота делят его; ≈ 20,6 ГБ VRAM. Рядом с кэшем ComfyUI не живёт — арбитр в режиме
# exclusive выгружает кэш (/free) перед возвратом (порог ARBITER_VRAM_NEEDED_MB = 22 000).
# Места CCS режет NumCtx движка (32 768), чаты провайдера — ContextWindow каталога (131 072).
# Один алиас = id каталога CCS: проба LocalEndpointProbe ищет модель в /v1/models по полю id.
ExecStart=/home/an/local-llm/bin/cuda133/llama-server \
  -m /home/an/local-llm/models/gemma-4-26B-A4B-it-UD-IQ4_XS.gguf \
  -a gemma-4-26b-a4b \
  --host 0.0.0.0 --port 18030 \
  -ngl 99 -fa on -c 262144 -np 4 -kvu -b 2048 -ub 512 \
  --reasoning auto \
  --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --repeat-penalty 1.0 --repeat-last-n 64 \
  --cache-ram 2048 \
  --metrics --no-webui
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

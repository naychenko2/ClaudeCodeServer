[Unit]
Description=Прокси claude CLI -> vLLM локальной модели: правит тело запроса ради prefix cache
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=an
# Запуск ИЗ КАТАЛОГА ВЫКЛАДКИ /opt/ccs/proxy/current (симлинк на неизменяемую версию из master),
# а не из рабочей копии: исполнители переключают в ней ветки, и 16.10 на бою оказался
# непроверенный код ветки. Обновляет и откатывает только tools/thinking-strip-proxy/deploy.sh.
ExecStart=/usr/bin/python3 /opt/ccs/proxy/current/proxy.py
Environment=UPSTREAM_HOST=127.0.0.1 UPSTREAM_PORT=18020 LISTEN_HOST=0.0.0.0 LISTEN_PORT=18021
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

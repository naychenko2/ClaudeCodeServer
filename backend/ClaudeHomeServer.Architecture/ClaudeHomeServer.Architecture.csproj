<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK (по образцу ProjectIcons/Backgrounds): IServiceCollection,
         IConfiguration, ILogger берутся из FrameworkReference Microsoft.AspNetCore.App.
         OutputType=Library и без Program.cs — обычный режим библиотеки. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT-стек для `JwtRegisteredClaimNames.Sub` в `ArchitectureController.UserId`
         (claim sub владельца) — тот же приём, что у Notes.csproj: FrameworkReference
         `System.IdentityModel.Tokens.Jwt` не подтягивает. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали Knowledge. По образцу CodeGraph/Skills/Git/Notes:
         SDK=Web ради FrameworkReference Microsoft.AspNetCore.App, OutputType=Library
         ради отсутствия Main. Тесты Knowledge используют хелперы ClaudeHomeServer.Tests
         (RecordingHubNotifier/NullDifyMetrics/PersonaDirectoryMock — после выноса
         Knowledge из Main в отдельный .csproj). -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Knowledge\ClaudeHomeServer.Knowledge.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- ProjectReference на Main ради ProjectManager/FileService/PersonaManager/UserStore
         и HubRecorder (хаб-рекордер для FileWatcherFullResyncTests). Прецедент — Notes.Tests. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Tests\ClaudeHomeServer.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <!-- Notes: динамический модуль — dll в modules/notes/ для ModuleLoader (тот же паттерн,
       что в ClaudeHomeServer.Tests и CodeGraph.Tests). Без DLL ModuleLoader не находит
       NotesSubsystem.Register, форвардер NotesKnowledgeService → IKnowledgeSyncParticipant
       не регистрируется, и Program_RegistersKnowledgeSubsystem видит 4 участника вместо 5. -->
  <Target Name="CopyNotesModuleForTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.Notes\bin\$(Configuration)\net10.0\ClaudeHomeServer.Notes.dll"
          DestinationFolder="$(OutDir)modules\notes" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.Notes\bin\$(Configuration)\net10.0\ClaudeHomeServer.Notes.dll')" />
  </Target>

</Project>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK (по образцу Spend/Notes/Knowledge): типов ASP.NET
         (IServiceCollection, IConfiguration, ILogger, IHostedService) много, и без
         Web SDK FrameworkReference Microsoft.AspNetCore.App их не подтягивает.
         OutputType=Library и без Program.cs — обычный режим библиотеки, Main не
         требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ТРИ сборки. ClaudeHomeServer.Tasks.Tests — тестовая сборка
         вертикали (internal-швы FeatureQueueService). ClaudeHomeServer (Main): контроллер
         TasksController.GetFeature (волна 2 «Обзор фич») зовёт internal static
         FeatureProjector.BuildEvents — направление Main → Tasks уже существует (Project/
         BuildIndex), новый шов не меняет его. ClaudeHomeServer.Tests (Main-тесты): после
         переноса тестов очереди в Tasks.Tests (хвост RV-K-Q6-BOUND-1) держит ОДНУ связь —
         TaskExecutionServiceDeviceWaitTests.ShouldAutoStart_ЗадачаЖдётУстройство зовёт internal
         static TaskSchedulerService.ShouldAutoStart (тест гейта device-wait живёт с сценарием
         TaskExecutionService в Main-сборке). Формат скопирован с Spend как образец Этапа 5. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tasks.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали ChatContext (шаг 3.8, пачка F). По образцу Mcp.Tests (3.6)
         и TestRuns.Tests (3.7): SDK=Web ради FrameworkReference Microsoft.AspNetCore.App
         (ILogger/IServiceCollection/TestHost/SignalR и пр. ASP.NET-типы, на которые опираются
         ChatContext-тесты), OutputType=Library ради отсутствия Main.
         ChatContext — namespace ClaudeHomeServer.Services.ChatContext в Core (продуктовые типы:
         ChatContextStore/ContextKindRegistry/…) + ChatContextController в Main: отдельной сборки
         вертикали нет, поэтому проект ссылается на Core+Main, как и монолит; это ожидаемо и не
         «утечка» (аналог Team.Tests, шаг 3.5). -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Монолит (ClaudeHomeServer.Tests) в переходный период (до финальной чистки)
         потребляет internal-члены перенесённых ChatContext-тестов (напр. ChatContextTestData/
         FakeKindProvider из ChatContextTestSupport.cs): допуск internals ChatContext.Tests монолиту. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Core — спинка: Models/Protocol и продуктовые ChatContext-типы (namespace
         ClaudeHomeServer.Services.ChatContext: ChatContextStore/ContextKindRegistry/ContextItem/…). -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- Main: ChatContextController (Services/Controllers) + Services.Composition/Services.Mcp.Http/
         Services.Prompts/Services.Turn, на которые опираются перенесённые ChatContext-тесты. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <!-- TestKit — Core-only хелперы (namespace ClaudeHomeServer.Tests.Helpers) + ImageEditorFakes
         (namespace ClaudeHomeServer.Tests.ImageEditor.Fakes), используемые ChatContext-тестами. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit\ClaudeHomeServer.TestKit.csproj" />
    <!-- TestKit.Host — Main-зависимые хелперы (TestWebApplicationFactory),
         используемые ChatContextController/ChatContextDisabledVertical/TurnContextMcpLive-тестами. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit.Host\ClaudeHomeServer.TestKit.Host.csproj" />
    <!-- Llm — продуктовая сборка: Services.Llm, на которые опирается TurnContextMcpLiveTests.
         Main тянет Llm транзитно (ReferenceOutputAssembly=true), явная ссылка — само-документирующая. -->
    <ProjectReference Include="..\ClaudeHomeServer.Llm\ClaudeHomeServer.Llm.csproj" />
    <!-- ImageEditor/AudioEditor/VideoEditor — динамические модули (ADR-018/021/022): Main тянет их
         с ReferenceOutputAssembly=false, поэтому типы (ImageEditorEndpoints/AudioStartJobForm/
         VideoEditor.Contracts) не приходят транзитно. ChatContextContracts/ChatContextController-тесты
         их используют напрямую — нужна прямая ссылка, как в монолите (ClaudeHomeServer.Tests.csproj)
         и как в Llm.Tests (шаг 3.1). -->
    <ProjectReference Include="..\ClaudeHomeServer.ImageEditor\ClaudeHomeServer.ImageEditor.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.AudioEditor\ClaudeHomeServer.AudioEditor.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.VideoEditor\ClaudeHomeServer.VideoEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- Moq — фейки IContextKindProvider/IChatContextNotifier в ChatContextStore/TurnContext*Tests;
         та же версия, что в монолите (ClaudeHomeServer.Tests.csproj). -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Xunit.SkippableFact — [SkippableFact] в ChatContextPromptsTests; та же версия, что в монолите. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <!-- ImageEditor/AudioEditor — динамические модули: ChatContextController/ChatContextDisabledVertical-тесты
       поднимают хост, который грузит модули через ModuleLoader (dll в modules/image-editor/ и
       modules/audio-editor/). Тот же паттерн Copy-таргетов, что в монолите (ClaudeHomeServer.Tests.csproj):
       без них ImageThreadStore/AudioThreadStore не регистрируются в DI и тесты падают. -->
  <Target Name="CopyImageEditorModuleForTests" AfterTargets="Build">
      <Copy SourceFiles="..\ClaudeHomeServer.ImageEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.ImageEditor.dll"
            DestinationFolder="$(OutDir)modules\image-editor" SkipUnchangedFiles="true"
            Condition="Exists('..\ClaudeHomeServer.ImageEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.ImageEditor.dll')" />
    </Target>
    <Target Name="CopyAudioEditorModuleForTests" AfterTargets="Build">
      <Copy SourceFiles="..\ClaudeHomeServer.AudioEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.AudioEditor.dll"
            DestinationFolder="$(OutDir)modules\audio-editor" SkipUnchangedFiles="true"
            Condition="Exists('..\ClaudeHomeServer.AudioEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.AudioEditor.dll')" />
  </Target>

</Project>

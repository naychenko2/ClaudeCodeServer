<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Монолит (ClaudeHomeServer.Tests) в переходный период (до финальной чистки)
         держит временную ссылку на эту сборку (ClaudeHomeServer.Tests.csproj):
         допуск internals Guards.Tests монолиту. BoundaryIlScanner — общий IL-скан
         (internal), которым пользуются оставшиеся в монолите LauncherProjectContextGuardTests
         и LocalLlmClientBoundaryTests; после переноса сторожей они видят его только через
         InternalsVisibleTo. Тот же приём, что у Telemetry.Tests/LocalStats.Tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Main: все вертикальные сборки (Reader/CodeGraph/Git/Tts/Changelog/Execution/
         Devices/Images/Prompts/Files/TestRuns/Deploy/Llm/... + Main-типы Mcp.Http/
         ChatContext/McpEndpoints) приходят транзитно: Main ссылается на все вертикали,
         и FrameworkReference Microsoft.AspNetCore.App течёт вместе с ним. Статические
         конструкторы сторожей (SubsystemBoundaryTests/SubsystemBoundaryCoverageTests/
         IlBoundaryRegressionTests/BoundaryIlScanner) форс-загружают эти сборки через
         typeof(...).Assembly — без явной ссылки на Main типы вертикалей не резолвятся. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <!-- Core — спинка: IAppSubsystem (сторож полноты SubsystemBoundaryTests.Boundaries)
         и IGitRepoChecker (IlBoundaryRegressionTests). -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!--
      Динамические модули: Main тянет их как ProjectReference с ReferenceOutputAssembly="false"
      (сборка в графе, но output-сборка НЕ видна для компиляции), поэтому они НЕ текут
      транзитно. Статические конструкторы сторожей форс-загружают их через
      typeof(...).Assembly, а McpToolsetStabilityTests/ProjectMapHygieneGuardTests читают их
      исходники — нужна явная ссылка (тот же приём, что в монолите ClaudeHomeServer.Tests.csproj).
    -->
    <ProjectReference Include="..\ClaudeHomeServer.Notes\ClaudeHomeServer.Notes.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Spend\ClaudeHomeServer.Spend.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.ImageEditor\ClaudeHomeServer.ImageEditor.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.AudioEditor\ClaudeHomeServer.AudioEditor.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.VideoEditor\ClaudeHomeServer.VideoEditor.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Architecture\ClaudeHomeServer.Architecture.csproj" />
    <!-- ParticipantTurnFrameGuardTests (S2a-5): поведенческий сторож поднимает живой хост
         (TestWebApplicationFactory из TestKit.Host) и зовёт tools/list / tools/call через
         транспорт — как McpNarrowFrameTests в монолите. Тот же приём, что в модульных
         тест-проектах (шаг 1.3): ссылка прямая, где реально нужен хост. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit.Host\ClaudeHomeServer.TestKit.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- McpToolsetStabilityTests: [SkippableFact]/[SkippableTheory] + Skip.If —
         тесты, которые скипаются, когда сборка вне дерева репозитория (нет node/
         исходников). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <!-- ParticipantTurnFrameGuardTests (S2a-5): поведенческий сторож поднимает живой хост и
       требует динамические модули в реестре MCP. ModuleLoader резолвит их относительные
       AssemblyPath от каталога теста (AppContext.BaseDirectory) — тот же паттерн копирования
       dll в modules/, что у ClaudeHomeServer.Tests.csproj и ClaudeHomeServer.CodeGraph.Tests.csproj.
       Без копии notes/architecture/image-editor/audio-editor/video-editor выпадают из реестра,
       и сторож видел бы неполный tools/list. -->
  <Target Name="CopyNotesModuleForTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.Notes\bin\$(Configuration)\net10.0\ClaudeHomeServer.Notes.dll"
          DestinationFolder="$(OutDir)modules\notes" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.Notes\bin\$(Configuration)\net10.0\ClaudeHomeServer.Notes.dll')" />
  </Target>
  <Target Name="CopyImageEditorModuleForTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.ImageEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.ImageEditor.dll"
          DestinationFolder="$(OutDir)modules\image-editor" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.ImageEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.ImageEditor.dll')" />
  </Target>
  <Target Name="CopyAudioEditorModuleForTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.AudioEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.AudioEditor.dll"
          DestinationFolder="$(OutDir)modules\audio-editor" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.AudioEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.AudioEditor.dll')" />
  </Target>
  <Target Name="CopyVideoEditorModuleForTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.VideoEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.VideoEditor.dll"
          DestinationFolder="$(OutDir)modules\video-editor" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.VideoEditor\bin\$(Configuration)\net10.0\ClaudeHomeServer.VideoEditor.dll')" />
  </Target>
  <Target Name="CopyArchitectureModuleForTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.Architecture\bin\$(Configuration)\net10.0\ClaudeHomeServer.Architecture.dll"
          DestinationFolder="$(OutDir)modules\architecture" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.Architecture\bin\$(Configuration)\net10.0\ClaudeHomeServer.Architecture.dll')" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK: типов ASP.NET (IServiceCollection, IConfiguration,
         ILogger, IHostedService, BackgroundService) много, и без Web SDK
         FrameworkReference Microsoft.AspNetCore.App их не подтягивает.
         OutputType=Library и без Program.cs — обычный режим библиотеки. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ДВЕ сборки: ClaudeHomeServer.Tests (существующие тесты
         в Main до переноса) и ClaudeHomeServer.Images.Tests (новая тестовая сборка).
         Образец — Dossiers/Turn. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Images.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Растр редактора (ADR-018 §9). Пакеты — только здесь: Core остаётся без пакетов
         (сторож CorePackageReferenceGuardTests). Нативка Linux — вариант NoDependencies:
         fontconfig не нужен, текст мы не рисуем; на Windows SkiaSharp сам тянет Win32.
         Публикация — строго с RID (-r linux-x64 / -r win-x64), иначе в runtimes/ уедет
         ~0,4 ГБ нативки под все платформы. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
  </ItemGroup>

</Project>

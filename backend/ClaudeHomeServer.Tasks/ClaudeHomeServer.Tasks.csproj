<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK (по образцу Spend/Notes/Knowledge): типов ASP.NET
         (IServiceCollection, IConfiguration, ILogger, IHostedService) много, и без
         Web SDK FrameworkReference Microsoft.AspNetCore.App их не подтягивает.
         OutputType=Library и без Program.cs — обычный режим библиотеки, Main не
         требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ТРИ сборки: ClaudeHomeServer.Tests (нужен существующим
         тестам в Main до переноса в отдельную сборку), ClaudeHomeServer.Tasks.Tests
         (новая тестовая сборка вертикали) и ClaudeHomeServer (Main): контроллер
         TasksController.GetFeature (волна 2 «Обзор фич») зовёт internal static
         FeatureProjector.BuildEvents — направление Main → Tasks уже существует (Project/
         BuildIndex), новый шов не меняет его. Формат скопирован с Spend как образец
         Этапа 5. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tasks.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

[Unit]
Description=Bonsai 2 9B (llama-server, PrismML fork) — дежурная модель одношаговых мест CCS
After=network-online.target
# Арбитр gpu-arbiter.service останавливает и запускает этот юнит; руками — только для отладки.

[Service]
User=an
WorkingDirectory=/home/an/bonsai
# Сборка cuda-13.3 форка + cudart/cublas 13 (копия из venv ComfyUI в cudalibs/cu13). Сборка
# cuda-12.8 лежит в bin/cuda128 запасной: ей нужны cudart/cublas 12 (колёса в cudalibs/*.whl).
Environment=LD_LIBRARY_PATH=/home/an/bonsai/cudalibs/cu13:/usr/lib/wsl/lib:/home/an/bonsai/bin/cuda133
Environment=CUDA_VISIBLE_DEVICES=0
# Сэмплинг — режим без размышлений из карточки 9B (temp 0.7, top-p 0.8, presence 1.5, окно 64).
# -c 16384 на -np 2 слота = 8192 на место (профили Small 4096 / Text 8192 каталога CCS;
# Large режется до NumCtx движка в конфиге CCS). KV у гибридного внимания мал.
# --reasoning auto: клиент выключает мышление через chat_template_kwargs enable_thinking=false.
ExecStart=/home/an/bonsai/bin/cuda133/llama-server \
  -m /home/an/bonsai/models/Ternary-Bonsai-2-9B-PQ2_0.gguf \
  -a bonsai-9b \
  --host 0.0.0.0 --port 18030 \
  -ngl 99 -fa on -c 16384 -np 2 -b 2048 -ub 512 \
  --reasoning auto \
  --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --repeat-penalty 1.0 --repeat-last-n 64 \
  --cache-ram 2048 \
  --metrics --no-webui
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

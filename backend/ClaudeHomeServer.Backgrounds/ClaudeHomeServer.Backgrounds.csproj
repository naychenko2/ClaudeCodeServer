<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK (по образцу Tts/Notes/Tasks/Modules/ProjectServices):
         типов ASP.NET много, без FrameworkReference Microsoft.AspNetCore.App они
         не подтягиваются. OutputType=Library и без Program.cs — обычный режим
         библиотеки, Main не требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на тестовую сборку Main (для уже существующих тестов
         до возможного переноса в собственную *.Backgrounds.Tests) и на будущую
         отдельную сборку тестов вертикали. Формат скопирован с Modules как
         образец. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Backgrounds.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

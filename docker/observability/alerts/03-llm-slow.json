{
  "alert": "Ходы стали медленнее",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "description": "p99 длительности хода выше пяти минут. Самое шумное правило из набора: долгий ход часто норма (большая задача), поэтому порог намеренно с запасом — поднимать его проще, чем возвращать доверие к алертам.",
  "evalWindow": "15m",
  "frequency": "10m",
  "labels": { "severity": "info" },
  "annotations": {
    "description": "p99 длительности хода перевалил за 5 минут. Если это не разовая большая задача — смотри, не деградировал ли провайдер.",
    "summary": "Деградация скорости ходов"
  },
  "preferredChannels": ["ccs-alerts-email"],
  "condition": {
    "selectedQueryName": "A",
    "op": "above",
    "matchType": "at_least_once",
    "target": 300000,
    "targetUnit": "ms",
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "disabled": false,
            "aggregations": [
              {
                "metricName": "ccs.llm.duration.bucket",
                "temporality": "Cumulative",
                "timeAggregation": "rate",
                "spaceAggregation": "p99"
              }
            ],
            "groupBy": [ { "name": "deployment.environment", "fieldDataType": "string" } ]
          }
        }
      ]
    }
  }
}

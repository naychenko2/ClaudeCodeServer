<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Динамический модуль «Видео» (ADR-022 §1), форма — как у AudioEditor: библиотека под
         Web SDK ради FrameworkReference Microsoft.AspNetCore.App, без Program.cs. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.VideoEditor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Только Core: всё внешнее — швы оттуда. Своих PackageReference нет — модуль грузится в
       дефолтный контекст по deps.json Main (сторож DynamicModulePackagesGuardTests). -->
  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

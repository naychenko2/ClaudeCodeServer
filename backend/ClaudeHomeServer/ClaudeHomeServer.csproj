<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Git.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Spend.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>


  <!-- appsettings.Local.json — машинно-специфичный конфиг ЭТОЙ машины разработчика:
       в publish не попадает (иначе затирает прод-конфиг при деплое поверх) -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Белый список имён значков (ADR-009 §5.2): генерируемая копия iconNames установленного
       lucide-react, правится только генератором (frontend/scripts/gen-glyph-names.mjs), не руками.
       LogicalName задан явно — код читает ресурс по короткому имени и не зависит от папок.
       Этап 5, волна C, шаг 2: перенесён в `ClaudeHomeServer.ProjectIcons.csproj`
       вместе с вертикалью (EmbeddedResource едет со сборкой, в которой живёт). -->

  <!-- Хостовый publish: встроенные MCP-серверы и дефолты CLI кладём рядом с exe —
       TasksServerLocator и синк workflows ищут их от AppContext.BaseDirectory
       (в контейнере это делала копия в /app из Dockerfile) -->
  <ItemGroup>
    <!-- Краткая карта для BareMode-провайдеров (SystemPrompts/CLAUDE-local.md) —
         путь относительно AppContext.BaseDirectory, нужна и в bin/ (dotnet run), и в
         /app/ (publish). Без копии флаг system-prompt-file укажет на несуществующий файл
         и ход провайдера упадёт (см. ревью 2026-09-05). -->
    <None Include="SystemPrompts\CLAUDE-local.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\mcp\**\*" LinkBase="mcp" CopyToPublishDirectory="PreserveNewest" />
    <!-- __tests__ исключаем: Node-хёрнессы не должны попадать в production-артефакт,
         их место в репозитории для локального/CI-прогона -->
    <!-- claude-defaults целиком, кроме Node-хёрнессов (__tests__) — они место в репозитории
       для локального/CI-прогона, в production-артефакт не нужны -->
    <None Include="..\..\claude-defaults\**\*" Exclude="..\..\claude-defaults\workflows\__tests__\**" LinkBase="claude-defaults" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ConPTY-мост Windows-терминала нужен рядом с сервером как ФАЙЛ (exe+dll+runtimeconfig),
       не как сборка: референс задаёт только порядок сборки, копирует Copy-таргет ниже.
       Условие на Windows обязательно: Docker-сборка (Linux) рестает ГОЛЫЙ ClaudeHomeServer.csproj
       до COPY backend/ — безусловный референс на ещё не скопированный проект уронил бы restore.
       На бою мост кладёт рядом с exe отдельный publish-шаг deploy80.ps1 -->
  <ItemGroup>
    <ProjectReference Include="..\ConPtyBridge\ConPtyBridge.csproj" Condition="'$(OS)' == 'Windows_NT'" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Копия выхода моста в bin сервера: ConPtyBridgeLocator ищет ConPtyBridge.exe
       от AppContext.BaseDirectory (dev-запуск dotnet run/F5) -->
  <Target Name="CopyConPtyBridge" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <ConPtyBridgeFiles Include="..\ConPtyBridge\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ConPtyBridgeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- === Модульность (Этап 3+, Этап 5)
       Вертикали Video/Yandex/Reader/CodeGraph/Skills/Git/Notes/Personas/Spend/Knowledge/
       Changelog/Diagnostics/Docs/Tts/WebSearch/Tasks/Modules/ProjectServices/Backgrounds
       вынесены в собственные .csproj и ссылаются только на Core. Здесь — обратная
       ссылка «Main → вертикаль» ради регистрации подсистем в Program.cs:
       AddSubsystems(new VideoSubsystem(), ...). Это не цикл: цепочка
       Main → Vertical → Core → (BCL). Core не ссылается ни на Main, ни на вертикали.
       До этапа 3 всё это жило одной сборкой, и инвариант «вертикаль зависит только
       от спинки» соблюдался логически; теперь он держится физически — вертикаль не
       может «протянуть руку» в Main, потому что ProjectReference в её .csproj нет. -->
  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Backgrounds\ClaudeHomeServer.Backgrounds.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Video\ClaudeHomeServer.Video.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Yandex\ClaudeHomeServer.Yandex.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Reader\ClaudeHomeServer.Reader.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.CodeGraph\ClaudeHomeServer.CodeGraph.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Changelog\ClaudeHomeServer.Changelog.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Diagnostics\ClaudeHomeServer.Diagnostics.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Desktop\ClaudeHomeServer.Desktop.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Docs\ClaudeHomeServer.Docs.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Dossiers\ClaudeHomeServer.Dossiers.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Memory\ClaudeHomeServer.Memory.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Skills\ClaudeHomeServer.Skills.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Git\ClaudeHomeServer.Git.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Knowledge\ClaudeHomeServer.Knowledge.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Llm\ClaudeHomeServer.Llm.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Modules\ClaudeHomeServer.Modules.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Notes\ClaudeHomeServer.Notes.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Personas\ClaudeHomeServer.Personas.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.ProjectIcons\ClaudeHomeServer.ProjectIcons.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.ProjectServices\ClaudeHomeServer.ProjectServices.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Spend\ClaudeHomeServer.Spend.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Tasks\ClaudeHomeServer.Tasks.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Terminal\ClaudeHomeServer.Terminal.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Tts\ClaudeHomeServer.Tts.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Turn\ClaudeHomeServer.Turn.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.WebSearch\ClaudeHomeServer.WebSearch.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.TriggerSources\ClaudeHomeServer.TriggerSources.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Watchdog\ClaudeHomeServer.Watchdog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.10" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.12.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <!-- OpenTelemetry.Instrumentation.Runtime не нужен: он даёт СВОЙ метр
         (OpenTelemetry.Instrumentation.Runtime) через AddRuntimeInstrumentation(), а мы
         слушаем встроенный в .NET метр System.Runtime — он есть в рантайме сам по себе.
         Пакет висел подключённым, но не вызывался ни разу. -->
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK: типов ASP.NET (IServiceCollection, IConfiguration,
         ILogger, IHostedService, BackgroundService) много, и без Web SDK
         FrameworkReference Microsoft.AspNetCore.App их не подтягивает.
         OutputType=Library и без Program.cs — обычный режим библиотеки. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ДВЕ сборки: ClaudeHomeServer.Tests (существующие тесты
         в Main до переноса) и ClaudeHomeServer.Images.Tests (новая тестовая сборка).
         Образец — Dossiers/Turn. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Images.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

</Project>

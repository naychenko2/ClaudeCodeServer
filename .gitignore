backend/**/bin/
backend/**/obj/
tools/**/bin/
tools/**/obj/
client/**/bin/
client/**/obj/
*.user
.vs/
data/

# Артефакты публикации и TLS-сертификаты
publish/
backend/publish_out/
backend/publish_out.bak/
backend/publish_staging/
certs/
domain/

# Собранный фронтенд — артефакт сборки, в репо не живет: прод получает wwwroot из
# frontend/dist агент выкатки (deploy-agent.ps1) или docker-образ; дев-стенд (dotnet run)
# отдаёт frontend/dist напрямую. Слепок в репе однажды уже приняли за «фикс не выкатан».
backend/ClaudeHomeServer/wwwroot/
backend/wwwroot/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
# Служебная диагностика плагина @module-federation/vite (пересоздаётся сборкой)
frontend/.mf/

# Playwright MCP
.playwright-mcp/

# MCP конфиги с ключами
.mcp.json
.mcp.docker.json

# mcp-dify
mcp-dify/node_modules/
mcp-dify/dist/

# mcp/tasks-server
mcp/tasks-server/node_modules/
mcp/tasks-server/dist/

# Среда
.env
.env.local
.env.prod
*.env

# Локальный override-конфиг (машинно-специфичные пути/секреты), у каждого свой.
# Со звёздочкой: ручные бэкапы вида appsettings.Local.json.bak-* несут те же секреты,
# а точное имя их не закрывало — git add -A утащил бы ключи в репозиторий
backend/ClaudeHomeServer/appsettings.Local.json*
# Локальные docker-compose оверрайды (машинно-специфичные, не для git)
docker-compose.*.local.yml
# Боевой сетевой конфиг деплоя (домен/серт grisha, порт 80) — не светим в git
backend/ClaudeHomeServer/appsettings.Production80.json
# Креды SigNoz для apply.ps1 (email/пароль из setup wizard UI)
docker/observability/.signoz-credentials.ps1

# IDE / JetBrains Rider (.idea игнорим; .run/ с шареными run-конфигами — коммитим)
.idea/

# OS
Thumbs.db
.DS_Store
.claude/worktrees/

# Скриншоты и debug-файлы
*.png
!frontend/public/pwa-*.png
!frontend/public/maskable-icon-*.png
!frontend/public/apple-touch-icon-*.png
!docs/assets/screenshots/*.png
*.jpg
*.log
onlyoffice/local.json

.omc/

# oh-my-opencode / oh-my-openagent state (Boulder, run-continuation, plans)
.omo/

# Определения агентов — машинно-специфичные, не версионируем (конфликтуют между сессиями):
# сюда PersonaAgentFileSync синкает персон владельца. Игнорим содержимое (не папку!),
# чтобы работали точечные исключения для общих проектных агентов ниже.
# Маска со ** — агент, запущенный с рабочей папкой внутри проекта, роняет копию .claude туда.
**/.claude/agents/*
!.claude/agents/designer.md

# Справочник профилей категорий делегирования — его кладёт PersonaAgentFileSync
# из константы OmoPrompts.DelegationCategoryProfiles (источник — docs/omo/translations)
**/.claude/delegation-categories.md

# Снятые из браузера дампы запросов (HAR) — несут токены сессии и данные аккаунта
*.har
api.txt

# Локальные одноразовые скрипты (замеры, пробы) — у каждого свои
*.local.mjs

# Планы командных механик — рабочие артефакты сессии (папка на каждый прогон, имя с id чата).
# Итог работы живёт в коммитах и документации, сами планы ценности вне прогона не имеют
docs/plans/

# Рабочие заметки владельца (vault «Заметки»): личные черновики, QA-приёмки, выписки.
# Они синкаются в базу знаний и между машинами конфликтуют — в репозитории им не место.
# Путь якорный (ведущий «/») — иначе правило ловит ЛЮБУЮ папку notes в дереве, и код
# фронта frontend/src/features/notes/ молча выпадает из репозитория (ловилось на ревью).
/notes/
!/notes/Доработки.md

# Одноразовые выходные каталоги локальных прогонов (dotnet test с кастомным OutDir, vitest из backend, playwright)
backend/.tmpbuild/
backend/.vite/
test-results/

# Планы plan-mode сессий (выход из планирования пишет сюда); итог работы живёт в коммитах
.claude/plans/

# Спайк браузерного канала: сырые дампы срезов (результаты — в отчёте и summary)
tools/browser-spike/results/raw/

# Сгенерированный манифест native messaging host (абсолютные пути — при установке)
tools/browser-spike/host/com.ccs.browser_spike.json
# Chrome for Testing: сборка и лог спайка
tools/browser-spike/cft/
tools/browser-spike/cft.zip

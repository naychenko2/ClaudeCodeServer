<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Интеграционные тесты ConPTY: Skip.IfNot(IsWindows) — на Linux CI честный skip -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на ClaudeHomeServer.Spend.Tests (Этап 5, вынос Spend):
         Spend.Tests использует internal TestLauncherFactory / FakeHostEnvironment /
         TestSessionBroadcaster (хелперы тестов), а Spend внутри Main вызывает
         internal SpendController.ClampPeriod/MaxPeriodDays. Без двойного допуска
         тесты Spend не соберутся в отдельной сборке. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Spend.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Tasks — отдельная сборка (Этап 5, вынос Tasks): Tests её вертикали
         живут в ClaudeHomeServer.Tasks.Tests; эта сборка нужна только чтобы
         статический конструктор `SubsystemBoundaryTests`/`SubsystemBoundaryCoverageTests`
         форс-загрузил Tasks через typeof(TaskManager).Assembly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tasks.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <!-- Core — спинка (этап 3, Этап 5). Тесты ссылаются на Core-DTO
         (`SubagentRunPassport`/`TurnRunPassport`/`RecallItem`/`RecallBlock` после
         переезда, И на Core-интерфейсы вроде `IKnowledgeIndex`). Транзитивно
         через Main типы в bin попадают, но для компиляции C#-файлов нужна явная
         ссылка на сборку. -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!--
      Знание — отдельная сборка (этап 5). Нужен ProjectReference, чтобы тесты
      видели IKnowledgeIndex/IKnowledgeSyncParticipant/KnowledgeDtos из Core,
      и компилировались Knowledge-вызовы в UserKnowledgeCascadeTests,
      PersonaMemoryServiceDossierSplitTests, NotesKnowledgeServiceDossierSplitTests
      и др. Сама по себе ссылка сборку в AppDomain не грузит — загрузка в .NET
      ленивая; явный форс лежит в статических конструкторах SubsystemBoundaryTests,
      RootSubsystemBoundaryTests и SubsystemBoundaryCoverageTests.
    -->
    <ProjectReference Include="..\ClaudeHomeServer.Knowledge\ClaudeHomeServer.Knowledge.csproj" />
    <!--
      Modules — отдельная сборка (Этап 5, волна C). Нужен ProjectReference, чтобы
      статический конструктор SubsystemBoundaryTests видел тип
      `ClaudeHomeServer.Services.Modules.ModuleRegistry` для force-загрузки сборки.
    -->
    <ProjectReference Include="..\ClaudeHomeServer.Backgrounds\ClaudeHomeServer.Backgrounds.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Modules\ClaudeHomeServer.Modules.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.ProjectIcons\ClaudeHomeServer.ProjectIcons.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Terminal\ClaudeHomeServer.Terminal.csproj" />
    <!--
      ProjectServices — отдельная сборка (Этап 5, волна C). Нужен ProjectReference,
      чтобы статический конструктор SubsystemBoundaryTests видел тип
      `ClaudeHomeServer.Services.ProjectServices.ProjectServicesSubsystem` для
      force-загрузки сборки.
    -->
    <ProjectReference Include="..\ClaudeHomeServer.ProjectServices\ClaudeHomeServer.ProjectServices.csproj" />
    <!-- Мост: юниты парсера кадров (internals) + интеграционные тесты гоняют exe из bin -->
    <ProjectReference Include="..\ConPtyBridge\ConPtyBridge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ограничение параллелизма планировщика: при 24 потоках блокирующие тесты
         (git, node MCP, буты веб-хостов) забивали слоты, стена росла на 40% и
         всплывали флаки (диагностика 2026-07-30). 6 — с запасом и для CI (4 ядра).
         Настройка снова живая: parallelizeTestCollections вернулся в true, классы с
         процесс-глобальным состоянием сериализуются коллекцией (TestCollections.cs) -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

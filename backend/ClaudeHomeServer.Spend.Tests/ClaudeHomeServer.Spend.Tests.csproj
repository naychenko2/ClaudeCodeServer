<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали Spend. По образцу Knowledge.Tests/Notes.Tests/Git.Tests:
         SDK=Web ради FrameworkReference Microsoft.AspNetCore.App, OutputType=Library
         ради отсутствия Main. Тесты Spend используют SessionManager/TaskManager/PersonaManager
         (создают экземпляры напрямую) и ChatHistoryService — все живут в Main. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Spend\ClaudeHomeServer.Spend.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- ProjectReference на Main ради SessionManager/TaskManager/PersonaManager/UserStore/
         ProjectManager/ChatHistoryService/JwtService/и пр. — тесты Spend резолвят полный
         стек для воссоздания сессии и её истории, как это делает прод. Прецедент —
         Knowledge.Tests/Notes.Tests. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Tests\ClaudeHomeServer.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <!-- Динамический модуль Spend: dll в modules/spend/ для ModuleLoader.
       AppContext.BaseDirectory тест-проекта — каталог сборки Spend.Tests, и именно
       отсюда ModuleLoader ищет modules/spend/ClaudeHomeServer.Spend.dll. -->
  <Target Name="CopySpendModuleForSpendTests" AfterTargets="Build">
    <Copy SourceFiles="..\ClaudeHomeServer.Spend\bin\$(Configuration)\net10.0\ClaudeHomeServer.Spend.dll"
          DestinationFolder="$(OutDir)modules\spend" SkipUnchangedFiles="true"
          Condition="Exists('..\ClaudeHomeServer.Spend\bin\$(Configuration)\net10.0\ClaudeHomeServer.Spend.dll')" />
  </Target>

</Project>

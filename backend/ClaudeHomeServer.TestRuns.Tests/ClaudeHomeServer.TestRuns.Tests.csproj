<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали TestRuns (шаг 3.7, пачка F). По образцу Mcp.Tests (3.6)
         и Notes.Tests: SDK=Web ради FrameworkReference Microsoft.AspNetCore.App
         (ILogger/IServiceCollection/TestHost и пр. ASP.NET-типы, на которые опираются
         TestRuns-тесты), OutputType=Library ради отсутствия Main.
         TestRuns — отдельная сборка (не папка Main): Main тянет её как ProjectReference,
         но internals TestRuns недоступны монолиту напрямую, поэтому ссылка прямая. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Монолит (ClaudeHomeServer.Tests) в переходный период (до финальной чистки)
         потребляет internal-члены перенесённых TestRuns-тестов (напр. TestRunServiceTests.Fixture):
         допуск internals TestRuns.Tests монолиту. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Core — спинка: Models/Protocol/Services.Execution, на которые ссылаются using'ы
         перенесённых тестов. -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- Main: TestRuns-тесты конструируют TestRunService/DotnetBuildService/NpmBuildService
         и опираются на Services.Llm/Services.Composition/Services.Devices/Services.Mcp.Http,
         на которые опираются все перенесённые тесты. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <!-- TestKit — Core-only хелперы (FakeHostEnvironment/TestLauncherFactory/TestConfig),
         используемые TestRuns-тестами. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit\ClaudeHomeServer.TestKit.csproj" />
    <!-- TestKit.Host — Main-зависимые хелперы (TestWebApplicationFactory),
         используемые TestRuns-тестами. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit.Host\ClaudeHomeServer.TestKit.Host.csproj" />
    <!-- TestRuns — продуктовая сборка вертикали (TestRunService, DotnetBuildService,
         NpmBuildService, парсеры). Отдельная сборка (не транзитивна через Main),
         ссылка прямая, как в монолите. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestRuns\ClaudeHomeServer.TestRuns.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- [SkippableFact] в UiProbeTests: замер на настоящем браузере пропускается, если нет node/playwright/chromium. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- TestRuns-фикстуры: тесты резолвят AppContext.BaseDirectory + "Services"/"TestRuns"/"Fixtures"/<name>
         (TestRunServiceTests.Fixture). Файлы не дублируем: относительная ссылка на источник в монолите
         (ClaudeHomeServer.Tests/Services/TestRuns/Fixtures) + Link, чтобы они легли в output
         TestRuns.Tests по пути Services/TestRuns/Fixtures/…. -->
    <None Include="..\ClaudeHomeServer.Tests\Services\TestRuns\Fixtures\**"
          CopyToOutputDirectory="PreserveNewest"
          Link="Services/TestRuns/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали Notes. По образцу CodeGraph/Skills/Git:
         SDK=Web ради FrameworkReference Microsoft.AspNetCore.App, OutputType=Library
         ради отсутствия Main. Тесты Notes — чистый парсинг / файловая система,
         без подъёма полного стенда; Notes не зависит от internals Main (в отличие
         от Git, который требует ProjectReference на Main ради DossierBranch).
         GlobalUsings.cs не нужен (нет параметризации Theory). -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Notes\ClaudeHomeServer.Notes.csproj" />
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- Main (шаг 2.1, оставлен): ProjectManager/UserStore конструируются напрямую
         (NotesServiceTests/NoteAnnotationTests/NotesAiConsumerTests), хост НЕ поднимается
         (нет TestWebApplicationFactory) — прямая ссылка на Main обязательна, TestKit.Host
         нет. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <!-- TestKit ради FakeHostEnvironment (Core-only хелпер) — используется в
         NotesServiceTests/NotesAiConsumerTests/NoteAnnotationTests для конструирования
         UserStore в тестах. Без этого пришлось бы дублировать хелперы. Шаг 1.3. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit\ClaudeHomeServer.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>

</Project>

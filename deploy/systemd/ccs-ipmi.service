[Unit]
Description=ccs-ipmi: опрос датчиков BMC через ipmitool (root, только чтение)
Documentation=file:///usr/local/lib/ccs-ipmi/ccs-ipmi-helper.py
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/ccs-ipmi/ccs-ipmi-helper.py
Restart=on-failure
RestartSec=5

# Результат для бэкенда и агента: /run/ccs-ipmi/sdr.json (читается всеми).
RuntimeDirectory=ccs-ipmi
RuntimeDirectoryMode=0755
UMask=0022

# Привилегий сверх root-владения /dev/ipmi0 (crw------- root) не нужно: набор пуст.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Файловая система и ядро — только чтение, домашние каталоги скрыты.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# Сети нет вовсе: ipmitool ходит к BMC через -I open (ядро), а не по LAN.
PrivateNetwork=yes
RestrictAddressFamilies=
IPAddressDeny=any

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Из устройств доступен только первый KCS-интерфейс BMC (ipmitool -d 0).
DevicePolicy=closed
DeviceAllow=/dev/ipmi0 rw

# Потолки: python + короткоживущий ipmitool раз в 15 с.
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target

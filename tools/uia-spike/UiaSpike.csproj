<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Спайк DPI-aware, чтобы координаты UIA совпадали с физическими пикселями кадра -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>uia-spike</AssemblyName>
    <RootNamespace>UiaSpike</RootNamespace>
    <!-- System.Drawing.Common идёт из Windows Desktop SDK; транзитивная уязвимость FlaUI для спайка неактуальна -->
    <NoWarn>NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека под Web SDK (по образцу Tts/Notes/Tasks/Modules/ProjectServices/Backgrounds):
         типов ASP.NET много, без FrameworkReference Microsoft.AspNetCore.App они
         не подтягиваются. OutputType=Library и без Program.cs — обычный режим
         библиотеки, Main не требуется. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo на тестовую сборку Main (для уже существующих тестов
         до возможного переноса в собственную *.ProjectIcons.Tests) и на будущую
         отдельную сборку тестов вертикали. Формат скопирован с Modules как
         образец. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.ProjectIcons.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

  <!-- Белый список имён значков (ADR-009 §5.2): генерируемая копия iconNames установленного
       lucide-react, правится только генератором (frontend/scripts/gen-glyph-names.mjs), не руками.
       LogicalName задан явно — код читает ресурс по короткому имени и не зависит от папок -->
  <ItemGroup>
    <EmbeddedResource Include="Services\ProjectIcons\lucide-icon-names.g.txt" LogicalName="lucide-icon-names.g.txt" />
  </ItemGroup>

</Project>

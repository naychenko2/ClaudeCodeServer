<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Библиотека тестовых хелперов, а НЕ тест-проект: vstest её не поднимает,
         хелперы здесь без [Fact]. IsTestProject=false явный, чтобы slnx/CI не
         пытались «прогнать» её как набор тестов. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Спинка: TestKit компилируется ТОЛЬКО против Core (никакого Main/ClaudeHomeServer).
         Microsoft.Extensions.* (Configuration/Hosting/FileProviders/Http) приходят
         транзитивно через FrameworkReference AspNetCore, который Core тянет как Web SDK.
         Это и есть цель шага 1.1: хелперы, которые раньше тащили ссылку на монолит,
         теперь стоят на Core. -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit: TestCollections (шаг 3.1) — [CollectionDefinition]-маркеры xunit-коллекций.
         Хелперы TestKit в целом без [Fact], но этот файл использует тест-раннер-атрибут,
         поэтому xunit.core нужен как PackageReference (не делает TestKit тест-проектом:
         IsTestProject=false выше). -->
    <PackageReference Include="xunit" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal-хелперы (TestLauncherFactory, InProcessExecStream, FakeDeviceAgent,
         DeviceSecretScanner, InotifyProbe, TestEnvironmentGuard, TestTelemetryGuard,
         FakeDeviceTurnGateway) видны только сборкам, которые реально их используют:
         монолит + Spend.Tests/Dossiers.Tests (TestLauncherFactory). Остальные модульные
         тест-проекты получают из TestKit только public-хелперы через транзитивную ссылку. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Spend.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Dossiers.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- ImageEditor.Tests (шаг 1.3): ImageEditorFakes (FakeHttp/FakeHiggsfieldAccess/
         RecordingBroadcaster/MemorySpendStore/TestImages) — internal, перенесены сюда из
         монолита (Core-only). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.ImageEditor.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- TestKit.Host (шаг 1.2): DeviceWaitTestHost конструирует SessionManager через
         TestLauncherFactory.Instance (internal) — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.TestKit.Host</_Parameter1>
    </AssemblyAttribute>
    <!-- Llm.Tests (шаг 3.3): перенесённые Llm-тесты (ImageLabeler/OneShotClaudeRunner*/
         TurnFileWatcherSubscription/InotifyLeakRegression) используют TestLauncherFactory
         и InotifyProbe (internal) — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Llm.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Team.Tests (шаг 3.5): TeamBlockerResolveTests/TeamWaveServiceTests используют
         TestLauncherFactory (internal) — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Team.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Mcp.Tests (шаг 3.6): DevToolsetTests/LocalMediaToolsetTests/TestsToolsetTests используют
         TestLauncherFactory (internal) — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.Mcp.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- ChatContext.Tests (шаг 3.8, пачка F): ChatContextControllerTests использует TestImages
         (internal, ImageEditorFakes) — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.ChatContext.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- LocalStats.Tests (шаг 3.10, пачка F): LocalModelLiveSinkTests использует
         TestLauncherFactory (internal) — тот же шов, что у монолита. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClaudeHomeServer.LocalStats.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тестовая сборка вертикали Deploy (шаг 3.11). По образцу Team.Tests (шаг 3.5) /
         Llm.Tests (шаг 3.1): SDK=Web ради FrameworkReference Microsoft.AspNetCore.App
         (TestWebApplicationFactory в DeployControllerTests/TrayDeployControllerTests поднимает
         ASP.NET-хост), OutputType=Library ради отсутствия Main.
         Deploy — отдельная сборка (ClaudeHomeServer.Deploy), не папка Main: её типы
         (DeployService/DeployHost/DeployLauncher/BuildIdProvider/DeployReportService) приходят
         транзитно через Main (Main → Deploy), поэтому явной ссылки на ClaudeHomeServer.Deploy
         нет — как и явной ссылки на Git/Execution (GitService, ILauncherFactory) — их тоже
         Main тянет транзитно. Явная ссылка на Main держит DeployAgentLockAdapter (Main-тип,
         использует DeployHostTests) и совпадает с составом остальных вертикальных тестов. -->
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core — спинка: Models/Services.Execution (ILauncherFactory/IProcessLauncher/ProcessSpec/
         IdentityPathMapper/LocalProcessRunner)/Services.Composition (IDeployAgentLock), на которые
         ссылаются using'ы перенесённых тестов. -->
    <ProjectReference Include="..\ClaudeHomeServer.Core\ClaudeHomeServer.Core.csproj" />
    <!-- Main: DeployAgentLockAdapter (Main-тип, DeployHostTests) + транзитно ClaudeHomeServer.Deploy
         (типы Deploy), ClaudeHomeServer.Git (GitService), ClaudeHomeServer.Execution. Main тянет все
         три как обычные ProjectReference, поэтому явных ссылок на них здесь нет. -->
    <ProjectReference Include="..\ClaudeHomeServer\ClaudeHomeServer.csproj" />
    <!-- TestKit — Core-only хелперы (TestFs), используемые Deploy-тестами. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit\ClaudeHomeServer.TestKit.csproj" />
    <!-- TestKit.Host — Main-зависимые хелперы (TestWebApplicationFactory), используемые
         DeployControllerTests/TrayDeployControllerTests. -->
    <ProjectReference Include="..\ClaudeHomeServer.TestKit.Host\ClaudeHomeServer.TestKit.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- [Skip.IfNot] в DeployHostTests (flock/файловый лок — только Linux). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

</Project>
